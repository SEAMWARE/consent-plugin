{
  "name": "participant registry",
  "metadata": {
    "comment": "GET /participants?identifier={DID} - the registry that maps the consumer DID from the token to the self-description URI sent to the OwnerResolver as parties.consumer. Set deregisteredAt to watch the gate deny."
  },
  "request": {
    "method": "GET",
    "urlPath": "/v1/participants",
    "queryParameters": {
      "identifier": {
        "equalTo": "did:key:zDevConsumer"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "content": [
        {
          "identifier": "did:key:zDevConsumer",
          "selfDescriptionUri": "http://mock:8080/participants/dev-consumer"
        }
      ],
      "page": 0,
      "size": 20,
      "totalElements": 1,
      "totalPages": 1
    }
  }
}
